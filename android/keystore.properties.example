# Copy to keystore.properties and fill in your own values.
#
#   cp android/keystore.properties.example android/keystore.properties
#
# Then generate the keystore (see docs/ANDROID_BUILD.md §5):
#   keytool -genkeypair -v -keystore rifq-release.jks -alias rifq \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# keystore.properties is git-ignored. Never commit real passwords.
storeFile=rifq-release.jks
storePassword=CHANGE_ME
keyAlias=rifq
keyPassword=CHANGE_ME
