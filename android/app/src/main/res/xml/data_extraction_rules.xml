<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup policy (Android 12+). Same intent as backup_rules.xml: keep prayer
  reminder schedules, never copy the WebView session profile off the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="rifq_alarms" />
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="rifq_alarms" />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
